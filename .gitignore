# state — regenerable with `jobd seed`, and contains scraped job data
jobd.db
jobd.db-wal
jobd.db-shm
jobd.db.backup-*

# compiled binaries
jobd-bin
resumegen-bin
jobd-linux
resumegen-linux

# vendored toolchain (tectonic, ~49MB) — fetched per machine, see DEPLOY.md
tools/

# render output (generated resumes + per-job selections)
out/

# never commit credentials — these live in ~/.config/jobd/
*.pem
*sa.json
*token.json
*client.json
.env
# anchored to the repo root: unanchored, these also matched cmd/jobd/ and
# cmd/resumegen/, silently ignoring the source directories they are built from
/resumegen
/jobd

# macOS noise
.DS_Store

# stray/typo databases and scratch selections
jobp
jobp-shm
jobp-wal
tmp-selection-*.json
